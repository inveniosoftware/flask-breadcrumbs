include .checkignore .coveragerc run-tests.sh pytest.ini tox.ini
include .lgtm MAINTAINERS
include LICENSE *.rst *.txt
include docs/*.rst docs/*.py docs/Makefile docs/requirements.txt
recursive-include docs/_templates *.html
recursive-include docs/_themes *.py *.css *.css_t *.conf *.html LICENSE README
recursive-include tests *.py
recursive-include .github/workflows *.yml
include .git-blame-ignore-revs
